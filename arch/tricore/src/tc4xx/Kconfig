#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

choice
	prompt "TC4XX Chip Selection"
	default ARCH_CHIP_TC4DX

config ARCH_CHIP_TC4DX
	bool "TC4XX TC4DX"

config ARCH_CHIP_TC4ZX
	bool "TC4XX TC4ZX"

config ARCH_CHIP_TC48X
	bool "TC4XX TC48X"

endchoice

comment "TC4XX Configuration Options"

config CPU_CLOCK_FREQUENCY
	int "CPU clock frequency (Hz)"
	default 400000000 if ARCH_CHIP_TC48X
	default 500000000

menu "TC4XX Peripheral Support"

# These are the peripheral selections proper

config TC4XX_UART0
	bool "TC4XX UART0"
	default y
	select UART0_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

endmenu
