# The M-profile core layer (exceptions, context switch, MPU, NVIC drivers,
# SysTick) is reused unchanged from arm_m; the qemu-m chip must not modify
# arch/arm/src/arm_m (REQ-6.5 / NFR-4).

include arm_m/Make.defs

CHIP_CSRCS  = qemu_m_start.c
CHIP_CSRCS += qemu_m_serial.c
CHIP_CSRCS += qemu_m_irq.c
CHIP_CSRCS += qemu_m_timer.c
CHIP_CSRCS += qemu_m_allocateheap.c
CHIP_CSRCS += qemu_m_cpuindex.c

ifeq ($(CONFIG_RTC),y)
CHIP_CSRCS += qemu_m_rtc.c
endif
