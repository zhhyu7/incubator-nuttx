#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config IVSHMEM
	bool
	default n
	---help---
		Inter-VM shared memory bus. Matches ivshmem devices registered by
		a backend (e.g. PCI) with the drivers that use them. Selected by
		the backends, not chosen directly.

config IVSHMEM_FLAT
	bool "QEMU ivshmem-flat driver"
	default n
	select IVSHMEM
	---help---
		Driver for the QEMU ivshmem-flat device: the ivshmem register
		block and shared memory as plain MMIO regions plus one irq, for
		machines without a PCI bus. The board registers each device with
		ivshmem_flat_register(), or from the device tree with
		fdt_ivshmem_flat_devices_register().

config RAMDISK_IVSHMEM
	bool "Ramdisk ivshmem driver"
	default n
	depends on IVSHMEM && !DISABLE_MOUNTPOINT
	---help---
		Enable ramdisk device driver.

config RAMDISK_IVSHMEM_IDTABLE
	string "The id table of ramdisk ivshmem device"
	depends on RAMDISK_IVSHMEM
	---help---
		"id0;id1;id2", e.g.: "0;1;2"


config UIO_IVSHMEM
	bool "Enable uio ivshmem driver support"
	default n
	depends on IVSHMEM
	---help---
		When this option is enabled, char ivshmem driver will register
		char device with name: "/dev/uioX" to the VFS, then
		application can open this device and use `mmap()` to get the
		share memory provided by ivshmem device.

config UIO_IVSHMEM_IDTABLE
	string "The id table of uio ivshmem device"
	depends on UIO_IVSHMEM
	---help---
		"id0;id1;id2", e.g.: "0;1;2"

config UIO_IVSHMEM_NPOLLWAITERS
	int "Uio ivshmem poll waiter number"
	default 2
	depends on UIO_IVSHMEM

config NOTERAM_IVSHMEM
	bool "Noteram ivshmem driver"
	default n
	depends on IVSHMEM && DRIVERS_NOTERAM
	---help---
		Enable noteram ivshemem

config NOTERAM_IVSHMEM_IDX
	int "The ivshmem id for note ram"
	default 2
	depends on NOTERAM_IVSHMEM
	---help---
		The index of the ivshmem device used for noteram share memory.
