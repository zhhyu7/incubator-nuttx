ifeq ($(CONFIG_DRIVERS_FAULT_INJECT),y)

CSRCS += fault_core.c
CSRCS += fault_dev.c

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_MM),y)
CSRCS += wraps/fault_wrap_mm.c
endif

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_IRQ),y)
CSRCS += wraps/fault_wrap_irq.c
endif

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_FS),y)
CSRCS += wraps/fault_wrap_fs.c
endif

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_SEM),y)
CSRCS += wraps/fault_wrap_sem.c
endif

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_MQ),y)
CSRCS += wraps/fault_wrap_mq.c
endif

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_WQ),y)
CSRCS += wraps/fault_wrap_wq.c
endif

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_SPI),y)
CSRCS += wraps/fault_wrap_spi.c
endif

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_I2C),y)
CSRCS += wraps/fault_wrap_i2c.c
endif

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_CAN),y)
CSRCS += wraps/fault_wrap_can.c
endif

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_CLK),y)
CSRCS += wraps/fault_wrap_clk.c
endif

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_RESET),y)
CSRCS += wraps/fault_wrap_reset.c
endif

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_RPTUN),y)
CSRCS += wraps/fault_wrap_rptun.c
endif

ifeq ($(CONFIG_DRIVERS_FAULT_INJECT_WRAP_WDG),y)
CSRCS += wraps/fault_wrap_wdg.c
endif

DEPPATH += --dep-path fault
DEPPATH += --dep-path fault/wraps
VPATH   += :fault:fault/wraps
CFLAGS  += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)drivers$(DELIM)fault

endif
