#ifndef _LIBCPP___CONFIG_SITE
#define _LIBCPP___CONFIG_SITE

#include <nuttx/config.h>
#include <nuttx/compiler.h>

// libcxx requires __BYTE_ORDER__ (since llvm18) TASKING doesn't predefine,
// use sys/endian.h to provide
#ifndef __BYTE_ORDER__
#  include <sys/endian.h>
#endif

#if defined(__TASKING__)
// Reuse the GCC classification so the type traits take their portable
// implementations. _LIBCPP_GCC_VER stays undefined, so it reads as 0
// where the headers compare it against the version that introduced
// those builtins, which is what keeps the portable side.
#  define _LIBCPP_COMPILER_GCC

// The __c11_atomic_ builtins take only a constant memory order, define this macro
// instead of checking __TASKING__ in libc++ source.
#  define _LIBCPP_C11_ATOMIC_CONSTANT_ORDER

// The __c11_atomic_ builtins take the delta of an atomic pointer as a byte
// count rather than scaling it by the pointee size.
#  define _LIBCPP_C11_ATOMIC_PTR_DELTA_IN_BYTES

// TASKING's __dynamic_cast has different argument types (erased to void *),
// which should be matched by libcxxabi.
#  define _LIBCXXABI_DYNAMIC_CAST_UNTYPED_ARGS
#endif

#define _LIBCPP_ABI_VERSION 1
#define _LIBCPP_ABI_NAMESPACE __1
#define _LIBCPP_NO_ABI_TAG

/* #undef _LIBCPP_ABI_FORCE_ITANIUM */
/* #undef _LIBCPP_ABI_FORCE_MICROSOFT */
#ifdef CONFIG_DISABLE_PTHREAD
#  define _LIBCPP_HAS_THREADS 0
#  define _LIBCPP_HAS_THREAD_API_PTHREAD 0
#else
#  define _LIBCPP_HAS_THREADS 1
#  define _LIBCPP_HAS_THREAD_API_PTHREAD 1
#endif
#define _LIBCPP_HAS_MONOTONIC_CLOCK 1
#define _LIBCPP_HAS_TERMINAL 0
#define _LIBCPP_HAS_MUSL_LIBC 0
#define _LIBCPP_HAS_THREAD_API_EXTERNAL 0
#define _LIBCPP_HAS_THREAD_API_WIN32 0
#define _LIBCPP_HAS_THREAD_API_C11 0
#define _LIBCPP_HAS_VENDOR_AVAILABILITY_ANNOTATIONS 0
#define _LIBCPP_HAS_FILESYSTEM 1
#define _LIBCPP_HAS_RANDOM_DEVICE 1
#define _LIBCPP_HAS_UNICODE 1
#define _LIBCPP_HAS_NO_STD_MODULES
#define _LIBCPP_HAS_TIME_ZONE_DATABASE 0
#define _LIBCPP_INSTRUMENTED_WITH_ASAN 0
#ifdef CONFIG_CXX_WCHAR
#  define _LIBCPP_HAS_WIDE_CHARACTERS 1
#else
#  define _LIBCPP_HAS_WIDE_CHARACTERS 0
#endif
#if defined(CONFIG_CXX_NO_LOCALIZATION)
#  define _LIBCPP_HAS_LOCALIZATION 0
#elif defined(CONFIG_CXX_MINI_LOCALIZATION)
#  define _LIBCPP_HAS_LOCALIZATION 1
#  define _LIBCPP_HAS_MINI_LOCALIZATION
#else
#  define _LIBCPP_HAS_LOCALIZATION 1
#endif
// PSTL backends
#define _LIBCPP_PSTL_BACKEND_SERIAL
// Hardening
#define _LIBCPP_HARDENING_MODE_DEFAULT _LIBCPP_HARDENING_MODE_NONE

#define _LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS
/* #undef _LIBCPP_NO_VCRUNTIME */
/* #undef _LIBCPP_TYPEINFO_COMPARISON_IMPLEMENTATION */

// Guard: some libcxx source files pre-define this without a value before including headers.
#ifndef _LIBCPP_DISABLE_DEPRECATION_WARNINGS
#  define _LIBCPP_DISABLE_DEPRECATION_WARNINGS 1
#endif
#define _LIBCPP_AVAILABILITY_HAS_NO_VERBOSE_ABORT 1

#ifndef __ULong
#define __ULong unsigned long
#endif

#define _SYS_REENT_H_

// Alias TASKING '__is_same_as' as '__is_same', which could benefit for other compilers,
// so we don't guard with __TASKING__
#if !__has_builtin(__is_same) && __has_builtin(__is_same_as)
#  define __is_same(_Tp, _Up) __is_same_as(_Tp, _Up)
#endif

#endif // _LIBCPP___CONFIG_SITE
